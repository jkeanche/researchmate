# ResearchMate AI configuration. Copy to .env and fill in.
# Variables without a default are required; the app refuses to start without them.

# --- Core ---------------------------------------------------------------
NODE_ENV=production
# Public URL (https required in production, except localhost).
APP_URL=https://researchmate.example.com
# openssl rand -base64 48
APP_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
# Encrypts TOTP secrets and (later) OAuth tokens and API keys. Back it up: losing it disables 2FA for every user.
ENCRYPTION_KEY=

# --- Database and Redis -------------------------------------------------
# Docker Compose builds DATABASE_URL/REDIS_URL from these:
POSTGRES_USER=researchmate
POSTGRES_PASSWORD=
POSTGRES_DB=researchmate
# Set directly when not using Compose:
# DATABASE_URL=postgres://researchmate:password@localhost:5432/researchmate
# REDIS_URL=redis://localhost:6379/0

# --- Storage ------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/var/lib/researchmate
# Platform-wide ceiling per upload; plan limits apply on top. Keep nginx client_max_body_size above this.
MAX_UPLOAD_SIZE_MB=100
# Hours a deleted file's stored bytes are kept before being erased.
FILE_RETENTION_HOURS=72
# S3-compatible storage arrives in the storage milestone:
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (required in production) -------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=ResearchMate AI <no-reply@researchmate.example.com>

# --- Auth ---------------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=true
SESSION_TTL_DAYS=30

# --- Workers ------------------------------------------------------------
WORKER_CONCURRENCY=4

# --- Later milestones (not read yet) ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DEFAULT_AI_PROVIDER=
DEFAULT_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
APIFY_API_TOKEN=
PAYMENT_PROVIDER=

# --- Nginx --------------------------------------------------------------
# Directory with fullchain.pem and privkey.pem
TLS_CERT_DIR=./infrastructure/nginx/certs
