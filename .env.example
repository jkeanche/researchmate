# ResearchMate AI configuration. Copy to .env and fill in.
# Variables without a default are required; the app refuses to start without them.

# --- Core ---------------------------------------------------------------
NODE_ENV=production
# Public URL (https required in production, except localhost).
APP_URL=https://researchmate.example.com
# openssl rand -base64 48
APP_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
# Encrypts TOTP secrets and (later) OAuth tokens and API keys. Back it up: losing it disables 2FA for every user.
ENCRYPTION_KEY=

# --- Database and Redis -------------------------------------------------
# Docker Compose builds DATABASE_URL/REDIS_URL from these:
POSTGRES_USER=researchmate
POSTGRES_PASSWORD=
POSTGRES_DB=researchmate
# Set directly when not using Compose:
# DATABASE_URL=postgres://researchmate:password@localhost:5432/researchmate
# REDIS_URL=redis://localhost:6379/0

# --- Storage ------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=/var/lib/researchmate
# Platform-wide ceiling per upload; plan limits apply on top. Keep nginx client_max_body_size above this.
MAX_UPLOAD_SIZE_MB=100
# Optional malware scanning with a ClamAV daemon (docker compose --profile clamav).
# When set, uploads are refused if infected, or while the scanner is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Hours a deleted file's stored bytes are kept before being erased.
FILE_RETENTION_HOURS=72
# S3-compatible storage (AWS S3, MinIO, Wasabi, Backblaze B2, Cloudflare R2…).
# Set STORAGE_DRIVER=s3 to use it. The bucket must already exist; it is
# probed with a write/delete at startup.
S3_BUCKET=
S3_REGION=
# Leave empty for AWS; e.g. https://minio.example.org for self-hosted servers.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted S3 servers (bucket in the URL path).
S3_FORCE_PATH_STYLE=false
# Optional key prefix so several environments can share one bucket.
S3_KEY_PREFIX=

# --- Email (required in production) -------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=ResearchMate AI <no-reply@researchmate.example.com>

# --- Auth ---------------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=true
SESSION_TTL_DAYS=30

# --- Workers ------------------------------------------------------------
WORKER_CONCURRENCY=4

# --- Names from the original specification (§35) -------------------------
# Accepted as aliases; the explicit settings further down win when both are set.
#   DEFAULT_AI_PROVIDER / DEFAULT_AI_MODEL       = PLATFORM_AI_PROVIDER / PLATFORM_AI_MODEL
#   OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_AI_API_KEY = PLATFORM_AI_API_KEY for that provider
#   APIFY_API_TOKEN                              = APIFY_TOKEN
#   PAYMENT_PROVIDER                             = provider offered first (paystack, pesapal, stripe)
DEFAULT_AI_PROVIDER=
DEFAULT_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
APIFY_API_TOKEN=
PAYMENT_PROVIDER=

# Google Drive (optional). Redirect URI: https://<your-domain>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Nginx --------------------------------------------------------------
# Directory with fullchain.pem and privkey.pem
TLS_CERT_DIR=./infrastructure/nginx/certs

GOOGLE_DRIVE_SCOPE=drive.file
# Allow AI/MCP endpoints on private networks (e.g. a model on the same server).
ALLOW_PRIVATE_ENDPOINTS=false
# Literature (phase 10)
# Contact email sent to Crossref/OpenAlex/NCBI ("polite pool"); recommended.
SCHOLARLY_CONTACT_EMAIL=
# Optional: higher Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=
# OCR scanned PDFs when tesseract + poppler-utils are installed in the worker.
OCR_ENABLED=true
# Optional: override where CSL citation styles are read from.
# CSL_DIR=

# Documents (phase 11): parallel LibreOffice renders in the worker.
DOCUMENT_CONCURRENCY=2

# Platform-funded AI (phase 13). Off unless enabled AND a price for this model is active.
PLATFORM_AI_ENABLED=false
# PLATFORM_AI_PROVIDER=openai
# PLATFORM_AI_MODEL=
# PLATFORM_AI_API_KEY=
# PLATFORM_AI_BASE_URL=
PLATFORM_AI_MAX_OUTPUT_TOKENS=4000

# Payments (see docs/architecture/payments.md). Each provider is enabled by its keys.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CURRENCIES=KES,USD
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# PESAPAL_IPN_ID=
# PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=3

# --- Operations -----------------------------------------------------------
# Bearer token for /api/metrics (Prometheus, --profile monitoring). At least 24 characters;
# leave empty to disable the endpoint. Generate with: openssl rand -hex 24
METRICS_TOKEN=
# Worker role when running the worker image by hand: all | jobs | scheduler
# (docker-compose.yml sets jobs for researchmate-worker and scheduler for researchmate-scheduler).
# WORKER_ROLE=all
# Backups (infrastructure/scripts/backup.sh)
# BACKUP_GPG_RECIPIENT=backups@your-domain.example
# BACKUP_RCLONE_REMOTE=remote:researchmate-backups
# BACKUP_KEEP=14
# INVOICE_ISSUER=ResearchMate Ltd | P.O. Box …, Nairobi | KRA PIN …

# Integrations (phase 14)
# APIFY_TOKEN=
# WEB_APPROVED_DOMAINS=who.int,worldbank.org
